# ─── Telegram Bot Credentials ───
API_ID=your_api_id
API_HASH=your_api_hash
ADMIN_ID=your_telegram_user_id

# ─── Main & Helper Bots ───
# Main Bot - Handles commands, status updates, and uploads
MAIN_BOT_TOKEN=your_main_bot_token
MAIN_BOT_NAME=DramaAutoDLBot

# Helper Bot - Rotates every 50 shows for uploading
HELPER_BOT_TOKEN=your_helper_bot_token
HELPER_BOT_NAME=DramaAutoDL2Bot

# ─── 4GB Premium String Session (Files > 1.89GB) ───
USER_SESSION_STRING=

# ─── Telegram Delivery Channels ───
# Primary upload channel
PRIMARY_CHANNEL_ID=-100xxxxxxxxxx

# Secondary forward/copy channels (comma separated)
FORWARD_CHANNEL_IDS=-100xxxxxxxxxx,-100xxxxxxxxxx,-100xxxxxxxxxx

# Delay between each channel delivery (seconds)
CHANNEL_DELAY_SECONDS=3

# Custom Caption for Specific Channels
CUSTOM_CAPTION_CHANNELS=-100xxxxxxxxxx,-100xxxxxxxxxx
CUSTOM_CAPTION_TEXT=PʀɪᴍᴇX Oꜰꜰɪᴄɪᴀʟ ➜ @PrimeXOfficial

# ─── Bot Rotation & Limits ───
BOT_SWITCH_COUNT=50
MAX_BOT_FILE_SIZE_GB=1.89
FORCE_PREMIUM_UPLOAD=false

# ─── Branding & Watermarking ───
ENABLE_WATERMARK=true
WATERMARK_TEXT=TG : @PrimeXOfficial
RELEASE_TAG=@PrimeXDramaBot

# ─── Show Fetch Source: lipat / kuku ───
# 'lipat' -> Fetches show metadata and stream manifests from Lipat Live Cloud Database (default)
# 'kuku'  -> Direct live fetch from KuKu API Flow
FETCH_SOURCE=lipat
LIPAT_ADMIN_TG_ID=999888777

# ─── Catalog Database Path ───
CATALOG_PATH=all_kuku_shows.json

# ─── Performance Settings ───
PROGRESS_UPDATE_INTERVAL_SECONDS=6
PARALLEL_DOWNLOAD_WORKERS=12

